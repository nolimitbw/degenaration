# ---- Telegram ----
# From BotFather. Treat as a password: anyone holding it controls the bot.
XZY_BOT_TOKEN=
XZY_BOT_USERNAME=xzyofficialbot

# Random secret sent by Telegram in X-Telegram-Bot-Api-Secret-Token on every webhook call.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Random path segment for the webhook URL, so the endpoint is not discoverable.
# Generate with: openssl rand -hex 16
TELEGRAM_WEBHOOK_PATH=

# ---- App ----
# Public HTTPS origin of this deployment. Telegram requires HTTPS for Mini Apps.
PUBLIC_APP_URL=

# Comma-separated numeric Telegram user IDs allowed into admin surfaces.
ADMIN_TELEGRAM_IDS=

# ---- Database ----
SUPABASE_URL=
# Service key. Bypasses row-level security — server only, never sent to a browser.
SUPABASE_SERVICE_KEY=

# ---- Trading ----
# Master key for encrypting wallet secret keys at rest. 64 hex chars.
# Generate with: openssl rand -hex 32
# LOSING THIS MEANS LOSING EVERY USER WALLET. Back it up before going live.
WALLET_ENCRYPTION_KEY=

# "live" enables real swaps. Anything else (or unset) quotes and prices for real but
# does not submit transactions, so the whole path can be exercised without moving funds.
TRADING_MODE=simulate

# Solana RPC. The public endpoint is rate-limited; use a dedicated provider in production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Bearer token the scheduler presents to /api/cron/monitor.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Jupiter swap API base. Jupiter has relocated this endpoint before, and offers a keyed
# tier at https://api.jup.ag/swap/v1 with higher rate limits.
# VERIFY against Jupiter's current docs before going live: npm run probe:jupiter
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
