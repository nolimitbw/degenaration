# ===== Frontend (safe to expose — NEXT_PUBLIC_) =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
NEXT_PUBLIC_SOLANA_RPC_URL=https://solana-rpc.publicnode.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DISCORD_BOT_CLIENT_ID=

# ===== Server-only (NEVER expose; set in Vercel/host env, not in client) =====
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=
ADMIN_OWNER_EMAILS=owner@example.com
ADMIN_KEY=
BOT_SHARED_SECRET=
REFERRAL_SIGNING_SECRET=
RATE_LIMIT_HASH_SALT=
SITE_URL=http://localhost:3000

# The Solana token account that receives your 2% platform fee:
PLATFORM_FEE_ACCOUNT=

# Mainnet RPC. Keep execution feature gates disabled until the release audit passes.
NEXT_PUBLIC_MAINNET_RPC=
MAINNET_RPC=
WORKER_NET=
DELEGATED_SIGNING=false
